NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
GATEWAY_PORT=3000
USER_PORT=3001
JOB_PORT=3002
APPLICATION_PORT=3003
RECOMMENDATION_PORT=3004
USER_SERVICE_URL=http://127.0.0.1:3001
JOB_SERVICE_URL=http://127.0.0.1:3002
APPLICATION_SERVICE_URL=http://127.0.0.1:3003
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:3004
MONGODB_URI=mongodb://127.0.0.1:27017
USER_DB=smartjob_users
JOB_DB=smartjob_jobs
APPLICATION_DB=smartjob_applications
# npm run setup generates secure local values for these two secrets.
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
JWT_EXPIRES_IN=8h
HTTP_TIMEOUT_MS=5000
GATEWAY_TIMEOUT_MS=10000
VITE_API_URL=http://localhost:3000/api
# Demo credentials are required only by npm run seed. Change before sharing.
DEMO_CANDIDATE_EMAIL=candidate@smartjob.local
DEMO_RECRUITER_EMAIL=recruiter@smartjob.local
DEMO_PASSWORD=
